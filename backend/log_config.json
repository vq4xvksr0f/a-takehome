{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "app.core.config.UtcIsoFormatter",
      "format": "%(asctime)s %(levelname)s [%(name)s] %(message)s"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "default"
    }
  },
  "root": {
    "handlers": ["stdout"],
    "level": "INFO"
  },
  "loggers": {
    "uvicorn.access": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    }
  }
}
