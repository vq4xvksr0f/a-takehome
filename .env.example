# ── Backend ───────────────────────────────────────────────
DATABASE_URL=sqlite:////data/leads.db
JWT_SECRET_KEY=dev-secret-change-me
# 8 hours, in minutes
JWT_EXPIRE_MINUTES=480
# Set true only behind HTTPS (production). Must be false for local http.
COOKIE_SECURE=false

# ── Admin seed (idempotent on startup) ────────────────────
ADMIN_EMAIL=admin@tryalma.com
ADMIN_PASSWORD=password
# Optional comma-separated extra admins, seeded with ADMIN_PASSWORD.
# Demo default gives a second login and varied activity-feed attribution.
EXTRA_ADMIN_EMAILS=paralegal@tryalma.com

# ── Email ─────────────────────────────────────────────────
# console = log emails to backend stdout (no key needed, default)
# resend  = send real email via Resend (requires RESEND_API_KEY)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Leads <onboarding@resend.dev>"
ATTORNEY_NOTIFY_EMAIL=attorney@tryalma.com

# ── S3 / MinIO ────────────────────────────────────────────
# Endpoint used by the backend to reach MinIO inside the compose network.
S3_ENDPOINT_URL=http://minio:9000
# Public base used to generate pre-signed URLs the browser can reach.
S3_PUBLIC_ENDPOINT=http://localhost:9900
S3_BUCKET=resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Frontend (server-side only; proxies /api to the backend) ─
BACKEND_URL=http://backend:8000
